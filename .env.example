DATABASE_URL=postgresql://news:local-news-only@127.0.0.1:55432/news
PORT=3000

# Search providers (issue #6). No payment method is attached; the collector
# enforces its own monthly call budget per provider and pauses before any
# overage. Six daily queries fit in 186 calls for a 31-day month.
EXA_API_KEY=
TAVILY_API_KEY=
SEARCH_EXA_MONTHLY_CALL_BUDGET=186
SEARCH_TAVILY_MONTHLY_CALL_BUDGET=186
