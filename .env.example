DATABASE_URL=postgresql://news:local-news-only@127.0.0.1:55432/news
# `neon deploy` replaces both URLs with the branch's pooled and direct strings.
DATABASE_URL_UNPOOLED=
PORT=3000
OLLAMA_PORT=11434

# Daily scheduled collection (scripts/run-dip.ts), in the order listed.
DIP_ELECTORAL_TERMS=21,20
# Set to 7 on the deployed cron. The two Render triggers are 05:00 and 06:00
# UTC; the Berlin-hour guard lets only the one that lands on 07:00
# Europe/Berlin collect, which absorbs daylight saving. Leave empty to collect
# on every trigger.
DIP_RUN_HOUR=
# Optional operator recovery window (ISO 8601). Setting either end bypasses
# the hour guard for this invocation; the checkpoint never moves backward.
DIP_BACKFILL_FROM=
# Omitted end means now.
DIP_BACKFILL_TO=
# Optional cap on unique proceedings per term. Empty means no cap.
DIP_PROCEEDING_CAP=

# Cloudflare R2 PDF archive (document worker only). Use a bucket-scoped token;
# development and production use separate buckets. EU buckets need the .eu host.
R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Search providers (issue #6). No payment method is attached; the collector
# enforces its own monthly call budget per provider and pauses before any
# overage. Six daily queries fit in 186 calls for a 31-day month.
EXA_API_KEY=
TAVILY_API_KEY=
SEARCH_EXA_MONTHLY_CALL_BUDGET=186
SEARCH_TAVILY_MONTHLY_CALL_BUDGET=186
