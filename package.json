{
  "name": "news-intelligenz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "prisma generate",
    "build": "prisma generate && next build",
    "build:test": "prisma generate && tsc -p tsconfig.node.json && node scripts/fix-dist-extensions.js",
    "build:collect": "prisma generate && tsc -p tsconfig.collect.json && node scripts/fix-dist-extensions.js",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "sh scripts/reset-db.sh",
    "dev": "pnpm db:migrate && next dev -H 127.0.0.1",
    "start": "pnpm db:migrate && next start -H 127.0.0.1",
    "studio": "prisma studio",
    "test": "pnpm build:test && node --test dist/test/*.test.js",
    "test:integration": "pnpm build:test && pnpm build && node --env-file-if-exists=.env --test dist/test/*.integration.js",
    "check": "prisma generate && tsc --noEmit -p tsconfig.node.json && tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "collect:dip": "pnpm build:collect && node --env-file-if-exists=.env dist/scripts/run-dip.js",
    "reindex:dip": "pnpm build:collect && node --env-file-if-exists=.env dist/scripts/reindex-dip.js",
    "evaluate:dip": "pnpm build:collect && node --env-file-if-exists=.env dist/scripts/evaluate-dip.js",
    "drain:dip": "pnpm build:collect && node --env-file-if-exists=.env dist/scripts/drain-dip.js",
    "backfill:documents": "pnpm build:collect && node --env-file-if-exists=.env dist/scripts/backfill-document-objects.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@langchain/core": "^1.3.0",
    "@langchain/textsplitters": "^1.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.2",
    "fast-xml-parser": "^5.11.1",
    "fast-xml-validator": "^1.4.2",
    "lucide-react": "^1.49.0",
    "next": "^16.4.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@neon/config": "^1.9.4",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "typescript": "^7.0.2"
  }
}
