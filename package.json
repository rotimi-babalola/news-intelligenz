{
  "name": "news-intelligenz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "prisma generate",
    "build": "prisma generate && next build",
    "build:test": "prisma generate && tsc -p tsconfig.node.json && node scripts/fix-dist-extensions.js",
    "db:migrate": "prisma migrate deploy",
    "dev": "pnpm db:migrate && next dev -H 127.0.0.1",
    "start": "pnpm db:migrate && next start -H 127.0.0.1",
    "studio": "prisma studio",
    "test": "pnpm build:test && node --test dist/test/*.test.js",
    "test:integration": "pnpm build:test && pnpm build && node --env-file-if-exists=.env --test dist/test/*.integration.js",
    "check": "prisma generate && tsc --noEmit -p tsconfig.node.json && tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.2",
    "fast-xml-parser": "^5.11.1",
    "fast-xml-validator": "^1.4.2",
    "next": "^16.3.8",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "typescript": "^7.0.2"
  }
}
