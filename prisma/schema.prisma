generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  running
  completed
  failed
}

enum Language {
  de
  en
}

enum IdentifierKind {
  guid
  url
}

enum ContentAvailability {
  metadata_only
  full_text
}

enum SourceKind {
  news_feed
  search_query
  dip_endpoint
}

enum JobStatus {
  pending
  claimed
  retrying
  succeeded
  exhausted
}

enum RelevanceDecision {
  accepted
  uncertain
  rejected
}

enum ParliamentaryEntity {
  vorgang
  vorgangsposition
  dokument
}

model Run {
  id           String        @id @db.Text
  feedId       String        @map("feed_id") @db.Text
  sourceKind   SourceKind    @map("source_kind") @default(news_feed)
  sourceScope  Json?         @map("source_scope")
  inputHash    String        @map("input_hash") @db.Text
  startedAt    DateTime      @map("started_at") @default(now()) @db.Timestamptz(6)
  completedAt  DateTime?     @map("completed_at") @db.Timestamptz(6)
  status       RunStatus
  validCount   Int           @map("valid_count") @default(0)
  invalidCount Int           @map("invalid_count") @default(0)
  error        String?       @db.Text
  candidates   Candidate[]
  discoveries  Discovery[]
  jobs         ProcessingJob[]
  parliamentaryDiscoveries ParliamentaryDiscovery[]

  @@map("runs")
}

model Publication {
  id                 String              @id @db.Uuid
  publisher          String              @db.Text
  headline           String              @db.Text
  originalUrl        String              @map("original_url") @db.Text
  publishedAt        DateTime?           @map("published_at") @db.Timestamptz(6)
  language           Language
  contentAvailability ContentAvailability @map("content_availability") @default(metadata_only)
  extractionError String? @map("extraction_error") @db.Text
  firstDiscoveredAt  DateTime            @map("first_discovered_at") @default(now()) @db.Timestamptz(6)
  lastDiscoveredAt   DateTime            @map("last_discovered_at") @default(now()) @db.Timestamptz(6)
  identifiers        PublicationIdentifier[]
  versions           PublicationVersion[]
  candidates         Candidate[]
  discoveries        Discovery[]

  @@map("publications")
}

model PublicationIdentifier {
  publisher     String         @db.Text
  kind          IdentifierKind
  value         String         @db.Text
  publicationId String         @map("publication_id") @db.Uuid
  publication   Publication    @relation(fields: [publicationId], references: [id])

  @@id([publisher, kind, value])
  @@map("publication_identifiers")
}

model PublicationVersion {
  id            String      @id @default(uuid()) @db.Uuid
  publicationId String      @map("publication_id") @db.Uuid
  publication   Publication @relation(fields: [publicationId], references: [id])
  versionNo     Int         @map("version_no")
  // Always fetched article text; feed excerpts are never stored here.
  text          String      @db.Text
  textHash      String      @map("text_hash") @db.Text
  finalUrl      String      @map("final_url") @db.Text
  fetchedAt     DateTime    @map("fetched_at") @default(now()) @db.Timestamptz(6)

  @@unique([publicationId, versionNo])
  @@map("publication_versions")
}

model Candidate {
  runId         String       @map("run_id") @db.Text
  itemIndex     Int          @map("item_index")
  metadata      Json
  errors        Json
  publicationId String?      @map("publication_id") @db.Uuid
  run           Run          @relation(fields: [runId], references: [id])
  publication   Publication? @relation(fields: [publicationId], references: [id])

  @@id([runId, itemIndex])
  @@map("candidates")
}

model Discovery {
  runId         String      @map("run_id") @db.Text
  publicationId String      @map("publication_id") @db.Uuid
  discoveredAt  DateTime    @map("discovered_at") @default(now()) @db.Timestamptz(6)
  run           Run         @relation(fields: [runId], references: [id])
  publication   Publication @relation(fields: [publicationId], references: [id])

  @@id([runId, publicationId])
  @@map("discoveries")
}

// Relevance review for search candidates: the agent records its assessment at
// intake and only accepted candidates enter shared processing. Uncertain
// candidates stay excluded until the operator accepts or rejects them;
// rejected rows remain inspectable. RSS candidates never get a decision.
model RelevanceReview {
  runId      String            @map("run_id") @db.Text
  itemIndex  Int               @map("item_index")
  decision   RelevanceDecision
  reason     String            @db.Text
  decidedBy  String            @map("decided_by") @db.Text
  decidedAt  DateTime          @map("decided_at") @default(now()) @db.Timestamptz(6)

  @@id([runId, itemIndex])
  @@map("relevance_reviews")
}

model SearchProviderCall {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @unique @map("run_id") @db.Text
  provider  String   @db.Text
  startedAt DateTime @map("started_at") @default(now()) @db.Timestamptz(6)

  @@index([provider, startedAt])
  @@map("search_provider_calls")
}

model ProcessingJob {
  id             String     @id @default(uuid()) @db.Uuid
  dedupeKey      String     @unique @map("dedupe_key") @db.Text
  sourceKind     SourceKind @map("source_kind")
  sourceKey      String     @map("source_key") @db.Text
  sourceScope    Json?      @map("source_scope")
  runId          String     @map("run_id") @db.Text
  run            Run        @relation(fields: [runId], references: [id])
  itemIndex      Int?       @map("item_index")
  operation      String     @db.Text
  payload        Json
  // Higher values are claimed first; on-demand document requests raise the
  // priority of work that already exists instead of duplicating it.
  priority       Int        @default(0)
  status         JobStatus  @default(pending)
  attempts       Int        @default(0)
  maxAttempts    Int        @map("max_attempts") @default(5)
  nextAttemptAt  DateTime   @map("next_attempt_at") @default(now()) @db.Timestamptz(6)
  claimedAt      DateTime?  @map("claimed_at") @db.Timestamptz(6)
  claimedBy      String?    @map("claimed_by") @db.Text
  leaseExpiresAt DateTime?  @map("lease_expires_at") @db.Timestamptz(6)
  lastError      String?    @map("last_error") @db.Text
  createdAt      DateTime   @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime   @map("updated_at") @updatedAt @db.Timestamptz(6)
  attemptsLog    JobAttempt[]

  @@index([status, nextAttemptAt])
  @@map("processing_jobs")
}

model JobAttempt {
  jobId      String        @map("job_id") @db.Uuid
  job        ProcessingJob @relation(fields: [jobId], references: [id])
  attemptNo  Int           @map("attempt_no")
  startedAt  DateTime      @map("started_at") @default(now()) @db.Timestamptz(6)
  finishedAt DateTime?     @map("finished_at") @db.Timestamptz(6)
  outcome    String?       @db.Text
  error      String?       @db.Text
  workerId   String?       @map("worker_id") @db.Text

  @@id([jobId, attemptNo])
  @@map("job_attempts")
}

// Parliamentary records (DIP) live apart from news publications. Identity is
// the DIP entity type plus its numeric-string API ID; steps link to
// proceedings through a plain vorgang_id column with no foreign key so steps
// whose parent has not been observed are retained instead of rejected.
// Document dates (datum), source update timestamps (aktualisiert) and
// observation times (observed_at) are stored separately and never conflated.
model Proceeding {
  apiId             String   @id @map("api_id") @db.Text
  title             String   @db.Text
  proceedingType    String   @map("proceeding_type") @db.Text
  electoralTerm     Int      @map("electoral_term")
  deliberationState String?  @map("deliberation_state") @db.Text
  documentDate      DateTime? @map("document_date") @db.Date
  sourceUpdatedAt   DateTime @map("source_updated_at") @db.Timestamptz(6)
  metadata          Json
  firstObservedAt   DateTime @map("first_observed_at") @default(now()) @db.Timestamptz(6)
  lastObservedAt    DateTime @map("last_observed_at") @default(now()) @db.Timestamptz(6)
  latestVersionNo   Int      @map("latest_version_no") @default(0)
  versions          ProceedingVersion[]

  @@map("proceedings")
}

model ProceedingVersion {
  id              String     @id @default(uuid()) @db.Uuid
  proceedingApiId String     @map("proceeding_id") @db.Text
  proceeding      Proceeding @relation(fields: [proceedingApiId], references: [apiId])
  versionNo       Int        @map("version_no")
  contentHash     String     @map("content_hash") @db.Text
  snapshot        Json
  sourceUpdatedAt DateTime   @map("source_updated_at") @db.Timestamptz(6)
  observedAt      DateTime   @map("observed_at") @default(now()) @db.Timestamptz(6)
  runId           String?    @map("run_id") @db.Text

  @@unique([proceedingApiId, versionNo])
  @@map("proceeding_versions")
}

model ProceedingStep {
  apiId           String   @id @map("api_id") @db.Text
  proceedingApiId String   @map("proceeding_id") @db.Text
  institution     String   @db.Text
  stepLabel       String   @map("step_label") @db.Text
  title           String   @db.Text
  documentType    String   @map("document_type") @db.Text
  documentDate    DateTime? @map("document_date") @db.Date
  sourceUpdatedAt DateTime @map("source_updated_at") @db.Timestamptz(6)
  metadata        Json
  firstObservedAt DateTime @map("first_observed_at") @default(now()) @db.Timestamptz(6)
  lastObservedAt  DateTime @map("last_observed_at") @default(now()) @db.Timestamptz(6)
  latestVersionNo Int      @map("latest_version_no") @default(0)
  versions        ProceedingStepVersion[]
  documentReference DocumentReference?

  @@index([proceedingApiId])
  @@map("proceeding_steps")
}

model ProceedingStepVersion {
  id              String         @id @default(uuid()) @db.Uuid
  stepApiId       String         @map("step_id") @db.Text
  step            ProceedingStep @relation(fields: [stepApiId], references: [apiId])
  versionNo       Int            @map("version_no")
  contentHash     String         @map("content_hash") @db.Text
  snapshot        Json
  sourceUpdatedAt DateTime       @map("source_updated_at") @db.Timestamptz(6)
  observedAt      DateTime       @map("observed_at") @default(now()) @db.Timestamptz(6)
  runId           String?        @map("run_id") @db.Text

  @@unique([stepApiId, versionNo])
  @@map("proceeding_step_versions")
}

// The vector column is written and searched with SQL because Prisma does not
// expose pgvector operators. The source identity and version remain explicit.
// `dokument` embeddings come from a fetched PDF variant; page 0 marks text
// that is not page-scoped (proceedings and steps).
model DipEmbedding {
  id                  String              @id @default(uuid()) @db.Uuid
  sourceEntity        ParliamentaryEntity @map("source_entity")
  sourceApiId         String              @map("source_api_id") @db.Text
  sourceVersionNo     Int                 @map("source_version_no")
  sourcePage          Int                 @map("source_page") @default(0)
  sourceChunk         Int                 @map("source_chunk") @default(0)
  model               String              @db.Text
  documentInstruction String              @map("document_instruction") @db.Text
  queryInstruction    String              @map("query_instruction") @db.Text
  embedding           Unsupported("vector(1024)")
  createdAt           DateTime            @map("created_at") @default(now()) @db.Timestamptz(6)

  @@unique([sourceEntity, sourceApiId, sourceVersionNo, sourcePage, sourceChunk, model, documentInstruction], map: "dip_embeddings_source_version_page_chunk_model_document_key")
  @@map("dip_embeddings")
}

// Current document reference per step, from the step's fundstelle. History
// lives in step version snapshots; the parent link is denormalized here so
// references resolve without joining through steps.
model DocumentReference {
  stepApiId       String         @id @map("step_id") @db.Text
  step            ProceedingStep @relation(fields: [stepApiId], references: [apiId])
  proceedingApiId String         @map("proceeding_id") @db.Text
  referenceId     String         @map("reference_id") @db.Text
  documentNumber  String         @map("document_number") @db.Text
  pdfUrl          String?        @map("pdf_url") @db.Text
  documentDate    DateTime?      @map("document_date") @db.Date
  metadata        Json
  observedAt      DateTime       @map("observed_at") @default(now()) @db.Timestamptz(6)

  @@index([proceedingApiId])
  @@index([referenceId])
  @@map("document_references")
}

// Fetched PDF variants, content-addressed by document reference and byte hash.
// Re-fetching identical bytes reuses the row; changed bytes become a new
// variant, and earlier variants are retained. Only the latest variant is
// searchable, so historical content never duplicates retrieval hits. Bytes live
// in object storage; the row keeps their content-addressed key and provenance.
model DocumentContent {
  id          String         @id @default(uuid()) @db.Uuid
  referenceId String         @map("reference_id") @db.Text
  variantNo   Int            @map("variant_no")
  byteHash    String         @map("byte_hash") @db.Text
  byteSize    Int            @map("byte_size")
  pageCount   Int            @map("page_count")
  // Null while a legacy row still needs its bytes archived; the backfill and
  // document worker upload from `bytes` or the source url and set the key.
  objectKey   String?        @map("object_key") @db.Text
  // Retained for rows written before the object-storage move so they can be
  // re-archived. New rows leave this null and archive on upload.
  bytes       Bytes?
  sourceUrl   String?        @map("source_url") @db.Text
  fetchedAt   DateTime       @map("fetched_at") @default(now()) @db.Timestamptz(6)
  isLatest    Boolean        @map("is_latest") @default(true)
  pages       DocumentPage[]
  chunks      DocumentChunk[]

  @@unique([referenceId, byteHash])
  @@unique([referenceId, variantNo])
  @@index([referenceId, isLatest])
  @@map("document_contents")
}

// Extracted page text: provenance for search results that point back at a
// specific page of a specific fetched variant.
model DocumentPage {
  contentId String          @map("content_id") @db.Uuid
  content   DocumentContent @relation(fields: [contentId], references: [id])
  pageNo    Int             @map("page_no")
  text      String          @db.Text

  @@id([contentId, pageNo])
  @@map("document_pages")
}

model DocumentChunk {
  contentId String          @map("content_id") @db.Uuid
  content   DocumentContent @relation(fields: [contentId], references: [id])
  pageNo    Int             @map("page_no")
  chunkNo   Int             @map("chunk_no")
  text      String          @db.Text

  @@id([contentId, pageNo, chunkNo])
  @@map("document_chunks")
}

// Distinct encounters between runs and parliamentary records: one row per
// (run, entity, apiId). Replaying a run reuses the row; a new run records a
// new encounter without duplicating the record or its versions.
model ParliamentaryDiscovery {
  runId        String              @map("run_id") @db.Text
  run          Run                 @relation(fields: [runId], references: [id])
  entity       ParliamentaryEntity
  apiId        String              @map("api_id") @db.Text
  discoveredAt DateTime            @map("discovered_at") @default(now()) @db.Timestamptz(6)

  @@id([runId, entity, apiId])
  @@index([entity, apiId])
  @@map("parliamentary_discoveries")
}

// Durable per-endpoint/scope progress for DIP collection. The checkpoint
// advances only after all pages of a window are stored; embedding and PDF
// jobs never hold it open.
model DipCheckpoint {
  endpoint       String    @db.Text
  electoralTerm  Int       @map("electoral_term")
  updatedThrough DateTime? @map("updated_through") @db.Timestamptz(6)
  updatedAt      DateTime  @map("updated_at") @updatedAt @db.Timestamptz(6)

  @@id([endpoint, electoralTerm])
  @@map("dip_checkpoints")
}
